#!/usr/bin/env bash
# DESC: Run local HTML questionnaire server for Kratt pilot/user tests
# USAGE: kratt questionnaire [options]
# ARGS: --host Bind host. Default: 127.0.0.1
# ARGS: --port Bind port. Default: 8877; falls back to a free port if busy
# ARGS: --output-dir Where responses are saved. Default: output/user-tests/questionnaires
# ARGS: --participant-id Participant ID, e.g. P01 (required to open the form)
# ARGS: --consent-level Consent level captured before the demo: "ainult mõõdikud" or "mõõdikud + helisalvestis" (required)
# ARGS: --session-id Session ID copied from session.json (optional)
# ARGS: --no-open Do not open browser automatically
# EXAMPLES: kratt questionnaire --participant-id P01 --consent-level "mõõdikud + helisalvestis"
# EXAMPLES: kratt questionnaire --participant-id P01 --consent-level "ainult mõõdikud" --session-id 20260510-abc
# EXAMPLES: kratt questionnaire --participant-id P01 --consent-level "mõõdikud + helisalvestis" --host 0.0.0.0 --port 8877
set -euo pipefail

SCRIPT="${KRATT_ROOT}/tools/user-testing/questionnaire_server.py"
PYTHON="${KRATT_ROOT}/.venv/bin/python"

if [[ ! -f "$SCRIPT" ]]; then
  echo "questionnaire server not found: $SCRIPT" >&2
  exit 1
fi
if [[ ! -x "$PYTHON" ]]; then
  echo "Python venv not found: $PYTHON" >&2
  echo "Run setup first (project venv)." >&2
  exit 1
fi

exec "$PYTHON" "$SCRIPT" "$@"
