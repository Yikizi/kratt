#!/usr/bin/env bash
# DESC: Watch thesis TeX sources, auto-compile PDF, and open/reload it in Zathura
# USAGE: kratt thesis-watch [--no-open] [--once] [--clean]
# EXAMPLES: kratt thesis-watch
# EXAMPLES: kratt thesis-watch --no-open
set -euo pipefail

ROOT="${KRATT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
THESIS_DIR="$ROOT/docs/thesis/thesis-tex-estonian"
MAIN_TEX="main.tex"
PDF_FILE="$THESIS_DIR/main.pdf"
OPEN_VIEWER=1
ONCE=0
CLEAN=0

usage() {
  cat <<'EOF'
Usage: kratt thesis-watch [--no-open] [--once] [--clean]

Keeps the TalTech LaTeX thesis PDF fresh while you read it in Zathura.
Any change to a .tex/.bib/input figure dependency triggers latexmk rebuild.
Zathura reloads main.pdf automatically after each successful rebuild.

Options:
  --no-open   Do not start Zathura; only run the compile watcher.
  --once      Compile once and exit.
  --clean     Run latexmk -C before compiling/watching.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-open)
      OPEN_VIEWER=0
      ;;
    --once)
      ONCE=1
      OPEN_VIEWER=0
      ;;
    --clean)
      CLEAN=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
  shift
done

if ! command -v latexmk >/dev/null 2>&1; then
  echo "latexmk not found. Install MacTeX/TeX Live first." >&2
  exit 1
fi

cd "$THESIS_DIR"

if [[ "$CLEAN" -eq 1 ]]; then
  latexmk -C "$MAIN_TEX"
fi

LATEXMK_ARGS=(-pdf -interaction=nonstopmode -halt-on-error -file-line-error -view=none "$MAIN_TEX")

if [[ "$ONCE" -eq 1 ]]; then
  exec latexmk "${LATEXMK_ARGS[@]}"
fi

# Ensure there is something for the PDF viewer to open, but keep going even if
# the current source has an error; latexmk -pvc will retry on the next save.
if [[ "$OPEN_VIEWER" -eq 1 && ! -f "$PDF_FILE" ]]; then
  latexmk "${LATEXMK_ARGS[@]}" || true
fi

if [[ "$OPEN_VIEWER" -eq 1 ]]; then
  if command -v zathura >/dev/null 2>&1; then
    # Zathura auto-reloads the file when latexmk replaces main.pdf.
    nohup zathura "$PDF_FILE" >/dev/null 2>&1 &
  elif command -v open >/dev/null 2>&1; then
    open "$PDF_FILE" >/dev/null 2>&1 || true
    echo "zathura not found; opened PDF with system viewer instead."
  else
    echo "No PDF viewer found; continuing with compile watcher only."
  fi
fi

echo "Watching thesis sources in $THESIS_DIR"
echo "Edit .tex/.bib files; latexmk rebuilds main.pdf automatically. Press Ctrl-C to stop."
exec latexmk -pvc "${LATEXMK_ARGS[@]}"
