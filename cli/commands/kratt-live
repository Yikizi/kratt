#!/usr/bin/env bash
# DESC: Live wake word test with MacBook microphone
# USAGE: kratt live [version] [threshold]
# ARGS: version     Model version (v1, v6, v7...). Default: latest.
# ARGS: threshold   Detection threshold 0.0-1.0. Default: 0.9.
# EXAMPLES: kratt live v7
# EXAMPLES: kratt live v7 0.85
# EXAMPLES: kratt live           # uses latest model
set -euo pipefail

VERSION="${1:-}"
THRESHOLD="${2:-0.9}"

if [[ -z "$VERSION" ]]; then
  VERSION=$(ls -d "${KRATT_WW}/models/kuule-kratt-v"* 2>/dev/null | sort -V | tail -1 | grep -o 'v[0-9]*')
  echo "Using latest: $VERSION"
fi

MODEL="${KRATT_WW}/models/kuule-kratt-${VERSION}/kuule_kratt_${VERSION}.tflite"

if [[ ! -f "$MODEL" ]]; then
  echo "Model not found: $MODEL"
  echo "Available:" && kratt models
  exit 1
fi

LOG_DIR="${KRATT_ROOT}/output/demo-logs"
CAPTURE_DIR="${KRATT_ROOT}/output/false-accepts"
OVERLAY_SWIFT="${KRATT_ROOT}/scripts/demo/kratt_detection_overlay.swift"
mkdir -p "${LOG_DIR}" "${CAPTURE_DIR}"

timestamp="$(date +%Y%m%d_%H%M%S)"
log_file="${LOG_DIR}/live_test_${timestamp}.log"
latest_link="${LOG_DIR}/live_test_latest.log"
ln -sfn "${log_file}" "${latest_link}"

overlay_pid=""
cleanup() {
  if [[ -n "${overlay_pid}" ]] && kill -0 "${overlay_pid}" 2>/dev/null; then
    kill "${overlay_pid}" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

if [[ -f "${OVERLAY_SWIFT}" ]]; then
  /usr/bin/env swift "${OVERLAY_SWIFT}" --log-file "${latest_link}" --text "KRATT KUULIS" --hide-after 2.5 >/dev/null 2>&1 &
  overlay_pid=$!
else
  echo "Warning: overlay script not found at ${OVERLAY_SWIFT}" >&2
fi

echo "Model: $VERSION ($(du -h "$MODEL" | cut -f1)), threshold: $THRESHOLD"
echo "Log: ${log_file}"
PYTHONUNBUFFERED=1 "${KRATT_WW}/.venv-microwakeword/bin/python" \
  "${KRATT_WW}/evaluation/live_test_tflite.py" \
  --model "$MODEL" --threshold "$THRESHOLD" --name "kuule kratt $VERSION" \
  --capture-dir "${CAPTURE_DIR}" --pre-roll-seconds 5 --post-roll-seconds 1 \
  --alert-sound ping \
  2>&1 | tee -a "${log_file}"
