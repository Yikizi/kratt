#!/usr/bin/env bash
# DESC: Live wake word test with MacBook microphone (microWakeWord TFLite or openWakeWord ONNX)
# USAGE: kratt live <version(s)> [threshold(s)]
# ARGS: version     One or more model tags/aliases (v16c, checkpoint-faph20, expert-a, or oww-v17-smoke2). Default: latest v*.
# ARGS: threshold   One threshold for all, or one per model in --mode window. Defaults: 0.997 single microWakeWord, 0.995 multi-model consensus, 0.5 openWakeWord.
# EXAMPLES: kratt live v15
# EXAMPLES: kratt live v15 0.97
# EXAMPLES: kratt live oww-v17-smoke2 0.5
# EXAMPLES: kratt live v6-residual v10 v15
# EXAMPLES: kratt live v6-residual v10 v15 0.997
# EXAMPLES: kratt live v6-residual v10 0.997 0.99
# EXAMPLES: kratt live checkpoint-faph20 v16c 0.995
set -euo pipefail

model_path_from_tag() {
  local tag="$1"
  printf '%s/models/kuule-kratt-%s/kuule_kratt_%s.tflite' "$KRATT_WW" "$tag" "$tag"
}

resolve_mww_model_tag() {
  local input="${1#kuule-kratt-}"

  # Short aliases for long checkpoint-FAPH diagnostic model names.
  case "$input" in
    checkpoint-faph)
      input="checkpoint-faph-v18d-clean96-pw96x4"
      ;;
    checkpoint-faph10)
      input="checkpoint-faph10-v18d-clean96-pw96x4"
      ;;
    checkpoint-faph20)
      input="checkpoint-faph20-v18d-clean96-pw96x4"
      ;;
  esac

  if [[ -f "$(model_path_from_tag "$input")" ]]; then
    printf '%s\n' "$input"
    return 0
  fi

  local matches=()
  local d tag
  while IFS= read -r d; do
    tag="${d##*/kuule-kratt-}"
    [[ -f "$(model_path_from_tag "$tag")" ]] && matches+=("$tag")
  done < <(find "${KRATT_WW}/models" -maxdepth 1 -type d -name "kuule-kratt-${input}*" 2>/dev/null | sort -V)

  if [[ ${#matches[@]} -eq 1 ]]; then
    printf '%s\n' "${matches[0]}"
    return 0
  fi

  if [[ ${#matches[@]} -gt 1 ]]; then
    echo "Ambiguous model alias: $1" >&2
    echo "Matches:" >&2
    for tag in "${matches[@]}"; do
      echo "  $tag" >&2
    done
    return 2
  fi

  echo "Model not found: $1" >&2
  return 1
}

# Parse args: split into versions and thresholds, keep extra flags passthrough.
VERSIONS=()
THRESHOLDS=()
EXTRA_ARGS=()

parse_opts_with_value() {
  local flag="$1"; local val="$2"
  if [[ -z "$val" ]]; then
    echo "Missing value for $flag" >&2
    exit 1
  fi
  EXTRA_ARGS+=("$flag" "$val")
}

while [[ "$#" -gt 0 ]]; do
  arg="$1"; shift || true

  case "$arg" in
    --threshold)
      while [[ "$#" -gt 0 && ! "$1" =~ ^-- ]]; do
        THRESHOLDS+=("$1")
        shift
      done
      if [[ ${#THRESHOLDS[@]} -eq 0 ]]; then
        echo "--threshold requires at least one value" >&2
        exit 1
      fi
      ;;
    --mode|--consensus-window-ms|--cooldown|--ma-window|--device|--alert-sound|--name|--capture-dir|--pre-roll-seconds|--post-roll-seconds|--log)
      parse_opts_with_value "$arg" "${1:-}"
      shift || true
      ;;
    --)
      # Pass through remaining args unmodified
      EXTRA_ARGS+=("$@")
      break
      ;;
    --*)
      # Unknown flag: pass through as-is
      EXTRA_ARGS+=("$arg")
      if [[ "$#" -gt 0 && ! "$1" =~ ^-- ]]; then
        EXTRA_ARGS+=("$1")
        shift
      fi
      ;;
    *)
      if [[ "$arg" =~ ^0\.[0-9]+$ ]] || [[ "$arg" =~ ^1\.0*$ ]]; then
        THRESHOLDS+=("$arg")
      elif [[ "$arg" == "+" ]]; then
        # Allow copying combo labels such as "checkpoint-faph20 + v16c".
        continue
      elif [[ "$arg" == *+* ]]; then
        IFS='+' read -ra parts <<< "$arg"
        for part in "${parts[@]}"; do
          [[ -n "$part" ]] && VERSIONS+=("$part")
        done
      else
        VERSIONS+=("$arg")
      fi
      ;;
  esac
done

# Defaults
if [[ ${#VERSIONS[@]} -eq 0 ]]; then
  v=$(ls -d "${KRATT_WW}/models/kuule-kratt-v"* 2>/dev/null | sort -V | tail -1 | grep -o 'v[0-9a-z-]*')
  VERSIONS=("$v")
  echo "Using latest: $v"
fi

# Resolve short aliases / unique prefixes before validation and display.
RESOLVED_VERSIONS=()
for v in "${VERSIONS[@]}"; do
  if [[ "$v" == oww-* ]]; then
    RESOLVED_VERSIONS+=("$v")
    continue
  fi

  if ! resolved_v="$(resolve_mww_model_tag "$v")"; then
    echo >&2
    kratt models >&2
    exit 1
  fi
  RESOLVED_VERSIONS+=("$resolved_v")
done
VERSIONS=("${RESOLVED_VERSIONS[@]}")

if [[ ${#VERSIONS[@]} -gt 1 ]]; then
  DEFAULT_THRESHOLD="0.995"  # multi-model default mirrors benchmark-like min consensus
elif [[ "${VERSIONS[0]}" == oww-* ]]; then
  DEFAULT_THRESHOLD="0.5"
else
  DEFAULT_THRESHOLD="0.997"
fi
if [[ ${#THRESHOLDS[@]} -eq 0 ]]; then
  THRESHOLDS=("$DEFAULT_THRESHOLD")
fi

# If single threshold given for multiple models, apply to all
if [[ ${#THRESHOLDS[@]} -eq 1 ]] && [[ ${#VERSIONS[@]} -gt 1 ]]; then
  single="${THRESHOLDS[0]}"
  THRESHOLDS=()
  for _ in "${VERSIONS[@]}"; do
    THRESHOLDS+=("$single")
  done
fi

LOG_DIR="${KRATT_ROOT}/output/demo-logs"
CAPTURE_DIR="${KRATT_ROOT}/output/false-accepts"
OVERLAY_SWIFT="${KRATT_ROOT}/scripts/demo/kratt_detection_overlay.swift"
mkdir -p "${LOG_DIR}" "${CAPTURE_DIR}"

timestamp="$(date +%Y%m%d_%H%M%S)"
log_file="${LOG_DIR}/live_test_${timestamp}.log"
latest_link="${LOG_DIR}/live_test_latest.log"
ln -sfn "${log_file}" "${latest_link}"

overlay_pid=""
cleanup() {
  if [[ -n "${overlay_pid}" ]] && kill -0 "${overlay_pid}" 2>/dev/null; then
    kill "${overlay_pid}" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

if [[ -f "${OVERLAY_SWIFT}" ]]; then
  /usr/bin/env swift "${OVERLAY_SWIFT}" --log-file "${latest_link}" --text "KRATT KUULIS" --hide-after 2.5 >/dev/null 2>&1 &
  overlay_pid=$!
else
  echo "Warning: overlay script not found at ${OVERLAY_SWIFT}" >&2
fi

# Single model mode
if [[ ${#VERSIONS[@]} -eq 1 ]]; then
  VERSION="${VERSIONS[0]}"
  THRESHOLD="${THRESHOLDS[0]}"
  if [[ "$VERSION" == oww-* ]]; then
    MODEL="${KRATT_WW}/models/openwakeword/${VERSION}/kuule_kratt_${VERSION//-/_}.onnx"
    if [[ ! -f "$MODEL" ]]; then
      # fallback for current naming: oww-v17-smoke2 -> kuule_kratt_oww_v17_smoke2.onnx
      MODEL="${KRATT_WW}/models/openwakeword/${VERSION}/kuule_kratt_${VERSION//-/_}.onnx"
    fi
    if [[ ! -f "$MODEL" ]]; then
      echo "openWakeWord model not found under: ${KRATT_WW}/models/openwakeword/${VERSION}/"
      exit 1
    fi
    OWW_PY="${KRATT_WW}/.venv-openwakeword/bin/python"
    if [[ ! -x "$OWW_PY" ]]; then
      echo "Missing openWakeWord venv: $OWW_PY"
      echo "Create it with: cd ${KRATT_WW} && uv venv .venv-openwakeword --python python3.11 && uv pip install -p .venv-openwakeword/bin/python openwakeword onnxruntime onnx sounddevice soundfile numpy"
      exit 1
    fi
    echo "openWakeWord model: $VERSION"
    echo "Threshold: $THRESHOLD"
    echo "Log: ${log_file}"
    PYTHONUNBUFFERED=1 "$OWW_PY" \
      "${KRATT_WW}/evaluation/live_test_openwakeword.py" \
      --model "$MODEL" --threshold "$THRESHOLD" --name "kuule kratt $VERSION" \
      --capture-dir "${CAPTURE_DIR}" --pre-roll-seconds 5 --post-roll-seconds 1 \
      --alert-sound ping \
      "${EXTRA_ARGS[@]}" \
      2>&1 | tee -a "${log_file}"
  else
    MODEL="$(model_path_from_tag "$VERSION")"

    if [[ ! -f "$MODEL" ]]; then
      echo "Model not found: $VERSION" >&2
      echo >&2
      kratt models >&2
      exit 1
    fi

    echo "Model: $VERSION"
    echo "Threshold: $THRESHOLD"
    echo "Log: ${log_file}"
    PYTHONUNBUFFERED=1 "${KRATT_WW}/.venv-microwakeword/bin/python" \
      "${KRATT_WW}/evaluation/live_test_tflite.py" \
      --model "$MODEL" --threshold "$THRESHOLD" --name "kuule kratt $VERSION" \
      --capture-dir "${CAPTURE_DIR}" --pre-roll-seconds 5 --post-roll-seconds 1 \
      --alert-sound ping \
      "${EXTRA_ARGS[@]}" \
      2>&1 | tee -a "${log_file}"
  fi

# Multi-model mode
else
  echo "Models:"
  # Validate all models exist
  for i in "${!VERSIONS[@]}"; do
    v="${VERSIONS[$i]}"
    m="$(model_path_from_tag "$v")"
    if [[ ! -f "$m" ]]; then
      echo "Model not found: $v" >&2
      echo >&2
      kratt models >&2
      exit 1
    fi
    t="${THRESHOLDS[$i]:-$DEFAULT_THRESHOLD}"
    printf "  %-44s threshold %s\n" "$v" "$t"
  done

  echo "Log: ${log_file}"
  echo ""
  PYTHONUNBUFFERED=1 "${KRATT_WW}/.venv-microwakeword/bin/python" \
    "${KRATT_WW}/evaluation/multi_model_live_test.py" \
    "${VERSIONS[@]}" --threshold "${THRESHOLDS[@]}" \
    "${EXTRA_ARGS[@]}" \
    --log "${log_file}" \
    2>&1 | tee -a "${log_file}"
fi
