#!/usr/bin/env bash
# DESC: Regression-test demo LLM intent routing against edge-case phrases
# USAGE: kratt demo-intent-test [options]
# ARGS: --model       Ollama model to test. Default: pipeline default gemma3:4b
# ARGS: --category    Run only one category; repeatable
# ARGS: --limit       Limit number of cases
# ARGS: --show-pass   Print passing cases too
# ARGS: --json        Emit machine-readable summary
# EXAMPLES: kratt demo-intent-test
# EXAMPLES: kratt demo-intent-test --category brightness_up --category brightness_down
# EXAMPLES: kratt demo-intent-test --model qwen2.5:3b --show-pass
set -euo pipefail

SCRIPT="${KRATT_ROOT}/tools/demo-pipeline/intent_regression.py"
VENV_PYTHON="${KRATT_ROOT}/.venv/bin/python"

if [[ ! -f "${VENV_PYTHON}" ]]; then
  echo "Venv not found: ${VENV_PYTHON}" >&2
  exit 1
fi

if ! curl -sf http://localhost:11434/api/tags >/dev/null 2>&1; then
  echo "Ollama not running. Start with: ollama serve" >&2
  exit 1
fi

exec "${VENV_PYTHON}" "${SCRIPT}" "$@"
