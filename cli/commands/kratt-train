#!/usr/bin/env bash
# DESC: Submit wake word training to HPC
# USAGE: kratt train <tag> [--steps N] [--mem N]
# ARGS: tag        Version tag (v8, v9...). Required.
# ARGS: --steps N  Training steps. Default: 10000.
# ARGS: --mem N    Slurm memory. Default: 48G.
# EXAMPLES: kratt train v8
# EXAMPLES: kratt train v8 --steps 15000
# EXAMPLES: kratt train v8 --steps 20000 --mem 64G
set -euo pipefail

TAG="${1:?Usage: kratt train <tag> [--steps N] [--mem N]}"
shift

STEPS="10000"
MEM="48G"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --steps) STEPS="$2"; shift 2 ;;
    --mem)   MEM="$2";   shift 2 ;;
    *)       echo "Unknown: $1"; exit 1 ;;
  esac
done

echo "Submitting ${TAG}: ${STEPS} steps, ${MEM} RAM"
ssh malinh@base.hpc.taltech.ee \
  "export KRATT_ROOT=~/kratt KRATT_DATA=/gpfs/mariana/smbhome/malinh/kratt-data && \
   bash ~/kratt/wake-word/training/scripts/submit_hpc_kuule_kratt.sh \
   --tag ${TAG} --training-steps ${STEPS} --mem ${MEM}"
