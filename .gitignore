hardware/esp32/esphome/*.onnx
hardware/esp32/esphome/**/*.onnx

# microWakeWord model manifests are text and can be committed if desired.
# Keep actual trained model binaries out of git.

# Evaluation outputs (generated, large or privacy-sensitive)
wake-word/evaluation/fuzz_runs/
wake-word/evaluation/det_curves*.json
# Flat files in evaluation/ are ad-hoc run outputs. Promote curated evidence to
# docs/research/artifacts/<dated-run>/ or wake-word/evaluation/reports/.
wake-word/evaluation/*.csv
wake-word/evaluation/*.html
wake-word/evaluation/*.png
wake-word/evaluation/*.pdf
!wake-word/evaluation/reports/
!wake-word/evaluation/reports/**
output/

# Audio test samples
*.m4a

# Temporary files
tmp/
temp/
*.tmp

# LaTeX build outputs
docs/thesis/**/*.aux
docs/thesis/**/*.bbl
docs/thesis/**/*.blg
docs/thesis/**/*.bcf
docs/thesis/**/*.log
docs/thesis/**/*.out
