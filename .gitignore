.mypy_cache/
.ruff_cache/

# Data files (too large/private/generated for git)
wake-word/data/raw/
wake-word/data/augmented/
wake-word/data/processed/
wake-word/data/external/
wake-word/data/_quarantine_duplicates/
wake-word/data/confusable_filter_training/
!wake-word/data/confusable_filter_training/README.md
# OHEM mined hard-example exports (large WAV bundles)
wake-word/data/mined/
stt-integration/kiirkirjutaja-source/models/
*.wav
*.mp3
*.flac
*.ogg

# Models (large files)
wake-word/models/checkpoints/
wake-word/models/production/*.tflite
wake-word/models/production/*.onnx
wake-word/models/production/*.h5
wake-word/models/kiirkirjutaja-int8/
wake-word/models/kiirkirjutaja-large-int8/
# Per-version training artifacts (keep only .tflite + analysis/*.json)
wake-word/models/kuule-kratt-*/logs/
wake-word/models/kuule-kratt-*/restore/
wake-word/models/kuule-kratt-*/stream_state_internal/
wake-word/models/kuule-kratt-*/tflite_stream_state_internal_quant/
wake-word/models/kuule-kratt-*/train/
wake-word/models/kuule-kratt-*/*.h5
wake-word/models/kuule-kratt-*/model_summary.txt
wake-word/models/kuule-kratt-*/training_config.yaml
# Per-model generated analysis plots/tables. Keep curated summaries as
# analysis/*.json and promote thesis figures/tables to docs/research/artifacts/.
wake-word/models/*/analysis/*.csv
wake-word/models/*/analysis/*.html
wake-word/models/*/analysis/*.png
wake-word/models/*/analysis/*.pdf
*.pb
*.pkl

# Local ML/firmware tool venvs
wake-word/.venv-microwakeword/

# Training artifacts (feature mmaps, logs, intermediate outputs)
wake-word/training/features/
wake-word/training/runs/

# External repos (clone separately)
external-repos/microWakeWord/
external-repos/openWakeWord/

# Keep archived work
!external-repos/iaib-proto/

# Secrets
**/secrets.yaml
*.key
*.pem
*.env

# IDE
.vscode/
.idea/
.serena/
.claude/

